<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fitsSystemWindows="true">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:implementationMode="performance"
        app:scaleType="fillCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/topGradient"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:background="@drawable/camera_top_gradient"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.dennis.s23camera.GridOverlayView
        android:id="@+id/gridOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/focusIndicator"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/focus_ring"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/modePhotoButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/mode_selected_background"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingHorizontal="10dp"
            android:text="@string/mode_photo"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/modePortraitButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:minWidth="72dp"
            android:paddingHorizontal="9dp"
            android:text="@string/mode_portrait"
            android:textColor="#D9FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/modeNightButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:minWidth="58dp"
            android:paddingHorizontal="9dp"
            android:text="@string/mode_night"
            android:textColor="#D9FFFFFF"
            android:textSize="12sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/thumbnailImage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/thumbnail_background"
            android:clipToOutline="true"
            android:contentDescription="@string/latest_photo"
            android:scaleType="centerCrop" />

    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/status_background"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:text="@string/camera_ready"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/camera_panel_background"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/lensRow"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/zoom06Button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:paddingHorizontal="2dp"
                android:text="@string/lens_06"
                android:textAllCaps="false"
                android:textSize="10sp" />

            <Space android:layout_width="5dp" android:layout_height="1dp" />

            <Button
                android:id="@+id/zoom1Button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:paddingHorizontal="2dp"
                android:text="@string/lens_1"
                android:textAllCaps="false"
                android:textSize="10sp" />

            <Space android:layout_width="5dp" android:layout_height="1dp" />

            <Button
                android:id="@+id/zoom3Button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:paddingHorizontal="2dp"
                android:text="@string/lens_3"
                android:textAllCaps="false"
                android:textSize="10sp" />

            <Space android:layout_width="5dp" android:layout_height="1dp" />

            <Button
                android:id="@+id/zoom10Button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:paddingHorizontal="2dp"
                android:text="@string/lens_10"
                android:textAllCaps="false"
                android:textSize="10sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/zoomLabel"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/zoom_label"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/zoomSlider"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="0"
                    android:splitTrack="false" />

            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/evLabel"
                    android:layout_width="58dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="EV +0.0"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/evSlider"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:max="0"
                    android:progress="0"
                    android:splitTrack="false" />

                <Button
                    android:id="@+id/evResetButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="54dp"
                    android:layout_height="32dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="1dp"
                    android:text="@string/ev_reset"
                    android:textAllCaps="false"
                    android:textSize="9sp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/flashButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:paddingHorizontal="2dp"
                android:text="@string/flash_button"
                android:textAllCaps="false"
                android:textSize="9sp" />

            <Space android:layout_width="6dp" android:layout_height="1dp" />

            <Button
                android:id="@+id/timerButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:paddingHorizontal="2dp"
                android:text="@string/timer_button"
                android:textAllCaps="false"
                android:textSize="9sp" />

            <Space android:layout_width="6dp" android:layout_height="1dp" />

            <Button
                android:id="@+id/switchCameraButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:paddingHorizontal="2dp"
                android:text="@string/switch_camera_button"
                android:textAllCaps="false"
                android:textSize="9sp" />

            <Space android:layout_width="8dp" android:layout_height="1dp" />

            <ImageButton
                android:id="@+id/captureButton"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/capture_button_background"
                android:contentDescription="@string/capture_photo"
                android:padding="0dp" />

            <Space android:layout_width="8dp" android:layout_height="1dp" />

            <Button
                android:id="@+id/gridButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:paddingHorizontal="2dp"
                android:text="@string/grid_button"
                android:textAllCaps="false"
                android:textSize="9sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
